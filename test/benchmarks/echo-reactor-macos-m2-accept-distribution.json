  "trace_source": "#define _DARWIN_C_SOURCE 1\n#include <errno.h>\n#include <inttypes.h>\n#include <pthread.h>\n#include <stdatomic.h>\n#include <stdio.h>\n#include <sys/socket.h>\n#include <unistd.h>\n#define LIMIT 65536\nstatic _Atomic unsigned listener_order[LIMIT];\nstatic _Atomic uint64_t counts[LIMIT];\nstatic _Atomic uint64_t thread_ids[LIMIT];\nstatic _Atomic unsigned next_listener;\nstatic int traced_listen(int fd, int backlog) {\n    int result = listen(fd, backlog);\n    if (result == 0 && fd >= 0 && fd < LIMIT)\n        atomic_store(&listener_order[fd], atomic_fetch_add(&next_listener, 1) + 1);\n    return result;\n}\nstatic int traced_accept(int fd, struct sockaddr *addr, socklen_t *len) {\n    int result = accept(fd, addr, len);\n    int saved_errno = errno;\n    if (result >= 0 && fd >= 0 && fd < LIMIT) {\n        uint64_t thread_id = 0;\n        (void)pthread_threadid_np(NULL, &thread_id);\n        atomic_store(&thread_ids[fd], thread_id);\n        atomic_fetch_add(&counts[fd], 1);\n    }\n    errno = saved_errno;\n    return result;\n}\n__attribute__((destructor)) static void report_trace(void) {\n    for (int fd = 0; fd < LIMIT; ++fd) {\n        unsigned order = atomic_load(&listener_order[fd]);\n        if (order)\n            fprintf(stderr, \"ACCEPT_TRACE listener=%u fd=%d accepted=%\" PRIu64 \" thread=%\" PRIu64 \"\\n\", order, fd, atomic_load(&counts[fd]), atomic_load(&thread_ids[fd]));\n    }\n}\n#define INTERPOSE(replacement, original) \\\n    __attribute__((used, section(\"__DATA,__interpose\"))) \\\n    static const struct { const void *replacement_fn; const void *original_fn; } \\\n    interpose_##replacement = {(const void *)replacement, (const void *)original}\nINTERPOSE(traced_listen, listen);\nINTERPOSE(traced_accept, accept);\n",
  "diagnostic_driver_source": "import hashlib,json,os,pathlib,re,shutil,signal,socket,statistics,subprocess,tempfile,time\nroot=pathlib.Path('/Users/isavita/git/lean-net'); binary=root/'.lake/build/bin/lean-net-echo'\nreport={'binary_sha256':hashlib.sha256(binary.read_bytes()).hexdigest(),'trace_source_sha256':hashlib.sha256(pathlib.Path('/tmp/lean-net-accept-trace.c').read_bytes()).hexdigest(),'method':'Disposable listen/accept DYLD interposer records successful accept per listener; ps CPU sample; one startup probe included in accept counts; production binary unchanged','runs':[]}\nwith tempfile.TemporaryDirectory(prefix='lean-net-accept-trace-') as d:\n d=pathlib.Path(d);serverpath=d/'server';clientpath=d/'client';shutil.copy2(binary,serverpath)\n subprocess.run(['cc','-O3','-std=c11','-Wall','-Wextra','-Wpedantic','-Werror',str(root/'test/bench_echo.c'),'-o',str(clientpath)],check=True)\n for workers,clients,connections,requests in [(8,1,100,1000000),(8,4,100,500000),(8,1,1000,200000)]:\n  with socket.socket() as s:s.bind(('127.0.0.1',0));port=s.getsockname()[1]\n  with tempfile.TemporaryFile(mode='w+') as log:\n   env=os.environ.copy();env['DYLD_INSERT_LIBRARIES']='/tmp/lean-net-accept-trace.dylib'\n   server=subprocess.Popen([str(serverpath),str(port),str(workers)],stdout=log,stderr=log,env=env)\n   try:\n    for _ in range(100):\n     if server.poll() is not None:raise RuntimeError('server startup exit')\n     try:\n      with socket.create_connection(('127.0.0.1',port),timeout=.1):break\n     except OSError:time.sleep(.01)\n    start=time.monotonic(); processes=[subprocess.Popen([str(clientpath),str(port),str(connections),str(requests),'16'],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True) for _ in range(clients)];samples=[]\n    while any(p.poll() is None for p in processes):\n     r=subprocess.run(['ps','-p',str(server.pid),'-o','pcpu=,rss='],capture_output=True,text=True,check=True)\n     cpu,rss=r.stdout.split();samples.append({'seconds':time.monotonic()-start,'cpu_percent':float(cpu),'rss_kib':int(rss)})\n     time.sleep(.25)\n    elapsed=time.monotonic()-start;loads=[]\n    for p in processes:\n     out,err=p.communicate(timeout=2)\n     if p.returncode:raise RuntimeError(err)\n     loads.append(json.loads(out))\n   finally:\n    if server.poll() is None:server.send_signal(signal.SIGINT)\n    code=server.wait(timeout=5);log.seek(0);logtext=log.read()\n    if code:raise RuntimeError(f'server exit {code}: {logtext}')\n   distribution=[dict(zip(['listener','fd','accepted','thread'],map(int,match))) for match in re.findall(r'ACCEPT_TRACE listener=(\\d+) fd=(\\d+) accepted=(\\d+) thread=(\\d+)',logtext)]\n   stable=[s for s in samples if s['seconds']>=1] or samples\n   run={'workers':workers,'client_processes':clients,'connections_per_client':connections,'requests_per_client':requests,'loads':loads,'aggregate_elapsed_upper_bound_seconds':elapsed,'aggregate_rps_lower_bound':clients*requests/elapsed,'cpu_percent_median':statistics.median(s['cpu_percent'] for s in stable),'cpu_percent_max':max(s['cpu_percent'] for s in stable),'distribution':distribution,'samples':samples}\n   report['runs'].append(run);print(json.dumps({k:v for k,v in run.items() if k!='samples'}),flush=True)\npathlib.Path('/tmp/lean-net-accept-distribution.json').write_text(json.dumps(report,indent=2)+'\\n')\n",
  "diagnostic_driver_source_sha256": "f47d14de60bb0696e5af31e1b3958ecb19e1b695202ad51d2588740d071113c0",
  "interpretation": "All successful accepts reached only the eighth/last-created listener in every run, including four independent native clients. This explains the observed one-core server use: seven event-loop threads receive no load connections. No inference about Lean contention under balanced load or Linux/Windows behavior is made. Timing with the tracer is diagnostic, not a throughput acceptance repetition.",
